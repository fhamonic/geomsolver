# A value typed in Properties and left without Enter: the field stays
# pending, and the status bar counts it.
open tests/data/tv_corner_ref.json
panel params
select param clr
wait 16
# The Value field of the sheet.
click L 800 781
wait 3
text "5"
wait 2
# Off the field, in the empty part of Properties.
click L 800 900
wait 4
shot
