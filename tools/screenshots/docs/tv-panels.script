# The corner TV as it loads, in a large window: the context menu of A; a
# box being dragged around the linkage; the formula pop-up of Add
# constraint on tv and couch, with the names that complete "cl".
size 3200 2000
open tests/data/tv_corner_ref.json
wait 16
# A's handle.
click R 921 1432
wait 4
shot menu.ppm
key Escape
action edit.clear_selection
wait 3
move 828 1380
wait 2
press L
move 1068 1520 10
wait 2
shot box.ppm
release L
wait 3
select let tv geometry couch
action formula.add_constraint
wait 8
text "cl"
wait 4
shot popup.ppm
