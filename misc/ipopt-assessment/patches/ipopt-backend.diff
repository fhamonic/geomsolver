diff -ruN -x imgui_backends -x imgui_fonts pristine/src/gs/solve/ipopt_backend.cpp src/src/gs/solve/ipopt_backend.cpp
--- pristine/src/gs/solve/ipopt_backend.cpp	1970-01-01 01:00:00.000000000 +0100
+++ src/src/gs/solve/ipopt_backend.cpp	2026-10-12 04:45:12.665725925 +0200
@@ -0,0 +1,499 @@
+#include "ipopt_backend.hpp"
+
+#include <algorithm>
+#include <atomic>
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <string>
+#include <string_view>
+
+#include <IpStdCInterface.h>
+
+namespace gs::detail {
+
+namespace {
+
+using uz = std::size_t;
+
+// Ipopt's nlp_lower_bound_inf / nlp_upper_bound_inf defaults.
+constexpr double kIpoptInf = 1e19;
+// Central-difference step of the FD Hessian, relative to max(1, |x_j|).
+constexpr double kFdStep = 1e-6;
+
+enum class StopReason { None, Stop, Maxeval, Stopval, Error };
+
+std::string_view ipopt_status_name(int s) {
+    switch(s) {
+        case Solve_Succeeded: return "Solve_Succeeded";
+        case Solved_To_Acceptable_Level: return "Solved_To_Acceptable_Level";
+        case Infeasible_Problem_Detected: return "Infeasible_Problem_Detected";
+        case Search_Direction_Becomes_Too_Small:
+            return "Search_Direction_Becomes_Too_Small";
+        case Diverging_Iterates: return "Diverging_Iterates";
+        case User_Requested_Stop: return "User_Requested_Stop";
+        case Feasible_Point_Found: return "Feasible_Point_Found";
+        case Maximum_Iterations_Exceeded: return "Maximum_Iterations_Exceeded";
+        case Restoration_Failed: return "Restoration_Failed";
+        case Error_In_Step_Computation: return "Error_In_Step_Computation";
+        case Maximum_CpuTime_Exceeded: return "Maximum_CpuTime_Exceeded";
+        case Maximum_WallTime_Exceeded: return "Maximum_WallTime_Exceeded";
+        case Not_Enough_Degrees_Of_Freedom:
+            return "Not_Enough_Degrees_Of_Freedom";
+        case Invalid_Problem_Definition: return "Invalid_Problem_Definition";
+        case Invalid_Option: return "Invalid_Option";
+        case Invalid_Number_Detected: return "Invalid_Number_Detected";
+        case Unrecoverable_Exception: return "Unrecoverable_Exception";
+        case NonIpopt_Exception_Thrown: return "NonIpopt_Exception_Thrown";
+        case Insufficient_Memory: return "Insufficient_Memory";
+        case Internal_Error: return "Internal_Error";
+        default: return "?";
+    }
+}
+
+bool finite_all(const double * p, uz count) {
+    for(uz i = 0; i < count; ++i)
+        if(!std::isfinite(p[i])) return false;
+    return true;
+}
+
+struct Ctx {
+    Ctx(LocalProblem & p, const LocalOptions & o)
+        : problem(p)
+        , opt(o)
+        , n(uz(p.n()))
+        , mi(uz(p.m_ineq()))
+        , me(uz(p.m_eq()))
+        , m(mi + me)
+        , fd(o.algorithm == Algorithm::IPOPT_FDH)
+        , cx(n)
+        , df(n)
+        , g(mi)
+        , dg(mi * n)
+        , h(me)
+        , dh(me * n)
+        , pdf(n)
+        , pg(mi)
+        , pdg(mi * n)
+        , ph(me)
+        , pdh(me * n)
+        , px(n)
+        , ix(n)
+        , ig(m) {}
+
+    LocalProblem & problem;
+    const LocalOptions & opt;
+    uz n, mi, me, m;
+    bool fd;
+    IpoptProblem ip = nullptr;
+
+    // Evaluation cache at cx (always with derivatives, like every SLSQP
+    // evaluation, so evaluation counts compare one to one).
+    std::vector<double> cx;
+    bool have = false, bad_value = false, bad_grad = false;
+    double f = 0.0;
+    std::vector<double> df, g, dg, h, dh;
+
+    // FD probe buffers, separate so probes keep the cache at the iterate.
+    double pf = 0.0;
+    std::vector<double> pdf, pg, pdg, ph, pdh, px;
+    // Divided differences of [grad f; jac g; jac h] per column j, at hx.
+    std::vector<double> hx, D;
+    bool have_h = false;
+
+    std::vector<double> ix, ig;  // GetIpoptCurrentIterate buffers
+    std::vector<double> stop_x;  // iterate that met stopval
+
+    std::exception_ptr error;
+    StopReason reason = StopReason::None;
+    long evaluations = 0, gradient_evaluations = 0, nonfinite = 0;
+    long hessian_evaluations = 0, hessians = 0, out_of_bounds = 0;
+    double oob_max = 0.0;
+    const char * where = "?";
+    int iterations = 0;
+
+    bool halted() {
+        if(error) return true;
+        if(opt.stop && opt.stop->load(std::memory_order_relaxed)) {
+            if(reason == StopReason::None) reason = StopReason::Stop;
+            return true;
+        }
+        return false;
+    }
+
+    void check_bounds(const double * x) {
+        double d = 0.0;
+        for(uz j = 0; j < n; ++j)
+            d = std::max({d, opt.lb[j] - x[j], x[j] - opt.ub[j]});
+        if(d > 0.0) {
+            ++out_of_bounds;
+            oob_max = std::max(oob_max, d);
+            if(std::getenv("GS_IPOPT_DEBUG_OOB"))
+                std::fprintf(stderr, "oob %.3e (in %s)\n", d, where);
+        }
+    }
+
+    // Evaluates into the given buffers; false when the problem threw.
+    bool raw_eval(const double * x, double * pf_, double * pdf_, double * pg_,
+                  double * pdg_, double * ph_, double * pdh_) {
+        LocalBuffers b;
+        b.f = pf_;
+        b.df = pdf_;
+        b.g = pg_;
+        b.dg = pdg_;
+        b.h = ph_;
+        b.dh = pdh_;
+        check_bounds(x);
+        try {
+            problem.evaluate(x, b);
+        } catch(...) {
+            error = std::current_exception();
+            return false;
+        }
+        ++evaluations;
+        ++gradient_evaluations;
+        return true;
+    }
+
+    bool ensure(const double * x) {
+        if(halted()) return false;
+        if(have && std::equal(x, x + n, cx.begin())) return true;
+        have = false;
+        if(!raw_eval(x, &f, df.data(), g.data(), dg.data(), h.data(),
+                     dh.data()))
+            return false;
+        bad_value = !std::isfinite(f) || !finite_all(g.data(), mi) ||
+                    !finite_all(h.data(), me);
+        bad_grad = !finite_all(df.data(), n) ||
+                   !finite_all(dg.data(), dg.size()) ||
+                   !finite_all(dh.data(), dh.size());
+        if(bad_value || bad_grad) ++nonfinite;
+        std::copy(x, x + n, cx.begin());
+        have = true;
+        return true;
+    }
+
+    // Gradient rows [grad f; jac g; jac h] at px into out ((1 + m) x n).
+    bool probe(double * out) {
+        if(!raw_eval(px.data(), &pf, pdf.data(), pg.data(), pdg.data(),
+                     ph.data(), pdh.data()))
+            return false;
+        ++hessian_evaluations;
+        std::copy(pdf.begin(), pdf.end(), out);
+        std::copy(pdg.begin(), pdg.end(), out + n);
+        std::copy(pdh.begin(), pdh.end(), out + n + mi * n);
+        if(!finite_all(out, (1 + m) * n)) {
+            ++nonfinite;
+            return false;
+        }
+        return true;
+    }
+
+    bool build_differences(const double * x) {
+        const uz block = (1 + m) * n;
+        D.assign(n * block, 0.0);
+        std::vector<double> plus(block), minus(block);
+        for(uz j = 0; j < n; ++j) {
+            const double step = kFdStep * std::max(1.0, std::fabs(x[j]));
+            // One-sided at a bound: the engine must stay inside the box.
+            const double xp = std::min(x[j] + step, opt.ub[j]);
+            const double xm = std::max(x[j] - step, opt.lb[j]);
+            if(!(xp > xm)) continue;
+            std::copy(x, x + n, px.begin());
+            px[j] = xp;
+            if(!probe(plus.data())) return false;
+            px[j] = xm;
+            if(!probe(minus.data())) return false;
+            const double inv = 1.0 / (xp - xm);
+            double * Dj = D.data() + j * block;
+            for(uz k = 0; k < block; ++k) Dj[k] = (plus[k] - minus[k]) * inv;
+        }
+        hx.assign(x, x + n);
+        have_h = true;
+        return true;
+    }
+
+    // Lower triangle, row by row, of the symmetrised FD Lagrangian Hessian.
+    bool hessian(const double * x, double obj_factor, const double * lambda,
+                 double * values) {
+        if(halted()) return false;
+        ++hessians;
+        if(!(have_h && std::equal(x, x + n, hx.begin())) &&
+           !build_differences(x))
+            return false;
+        const uz block = (1 + m) * n;
+        // H(r, j) = d/dx_j of dL/dx_r.
+        std::vector<double> H(n * n, 0.0);
+        for(uz j = 0; j < n; ++j) {
+            const double * Dj = D.data() + j * block;
+            for(uz r = 0; r < n; ++r) {
+                double v = obj_factor * Dj[r];
+                for(uz i = 0; i < m; ++i) v += lambda[i] * Dj[n + i * n + r];
+                H[r * n + j] = v;
+            }
+        }
+        uz k = 0;
+        for(uz r = 0; r < n; ++r)
+            for(uz j = 0; j <= r; ++j)
+                values[k++] = 0.5 * (H[r * n + j] + H[j * n + r]);
+        return true;
+    }
+};
+
+bool eval_f(ipindex, ipnumber * x, bool, ipnumber * obj, UserDataPtr u) {
+    auto & c = *static_cast<Ctx *>(u);
+    c.where = "eval_f";
+    if(!c.ensure(x) || !std::isfinite(c.f)) return false;
+    *obj = c.f;
+    return true;
+}
+
+bool eval_grad_f(ipindex, ipnumber * x, bool, ipnumber * grad, UserDataPtr u) {
+    auto & c = *static_cast<Ctx *>(u);
+    c.where = "eval_grad_f";
+    if(!c.ensure(x) || !finite_all(c.df.data(), c.n)) return false;
+    std::copy(c.df.begin(), c.df.end(), grad);
+    return true;
+}
+
+bool eval_g(ipindex, ipnumber * x, bool, ipindex, ipnumber * g, UserDataPtr u) {
+    auto & c = *static_cast<Ctx *>(u);
+    c.where = "eval_g";
+    if(!c.ensure(x)) return false;
+    if(!finite_all(c.g.data(), c.mi) || !finite_all(c.h.data(), c.me))
+        return false;
+    std::copy(c.g.begin(), c.g.end(), g);
+    std::copy(c.h.begin(), c.h.end(), g + c.mi);
+    return true;
+}
+
+bool eval_jac_g(ipindex, ipnumber * x, bool, ipindex, ipindex, ipindex * iRow,
+                ipindex * jCol, ipnumber * values, UserDataPtr u) {
+    auto & c = *static_cast<Ctx *>(u);
+    if(!values) {
+        uz k = 0;
+        for(uz i = 0; i < c.m; ++i)
+            for(uz j = 0; j < c.n; ++j) {
+                iRow[k] = static_cast<ipindex>(i);
+                jCol[k] = static_cast<ipindex>(j);
+                ++k;
+            }
+        return true;
+    }
+    c.where = "eval_jac_g";
+    if(!c.ensure(x)) return false;
+    if(!finite_all(c.dg.data(), c.dg.size()) ||
+       !finite_all(c.dh.data(), c.dh.size()))
+        return false;
+    std::copy(c.dg.begin(), c.dg.end(), values);
+    std::copy(c.dh.begin(), c.dh.end(), values + c.dg.size());
+    return true;
+}
+
+bool eval_h(ipindex, ipnumber * x, bool, ipnumber obj_factor, ipindex,
+            ipnumber * lambda, bool, ipindex, ipindex * iRow, ipindex * jCol,
+            ipnumber * values, UserDataPtr u) {
+    auto & c = *static_cast<Ctx *>(u);
+    if(!values) {
+        uz k = 0;
+        for(uz r = 0; r < c.n; ++r)
+            for(uz j = 0; j <= r; ++j) {
+                iRow[k] = static_cast<ipindex>(r);
+                jCol[k] = static_cast<ipindex>(j);
+                ++k;
+            }
+        return true;
+    }
+    if(!c.fd) return false;
+    c.where = "eval_h";
+    return c.hessian(x, obj_factor, lambda, values);
+}
+
+bool intermediate(ipindex, ipindex iter, ipnumber, ipnumber, ipnumber,
+                  ipnumber, ipnumber, ipnumber, ipnumber, ipnumber, ipindex,
+                  UserDataPtr u) {
+    auto & c = *static_cast<Ctx *>(u);
+    c.iterations = static_cast<int>(iter);
+    if(c.error) {
+        c.reason = StopReason::Error;
+        return false;
+    }
+    if(c.halted()) return false;
+    // FD probes do not count: the FD Hessian stands in for an exact one.
+    if(c.evaluations - c.hessian_evaluations >= c.opt.maxeval) {
+        c.reason = StopReason::Maxeval;
+        return false;
+    }
+    if(std::isfinite(c.opt.stopval)) {
+        // Restoration iterates are mapped back to the original NLP too.
+        if(!GetIpoptCurrentIterate(c.ip, false, static_cast<ipindex>(c.n),
+                                   c.ix.data(), nullptr, nullptr,
+                                   static_cast<ipindex>(c.m), nullptr, nullptr))
+            return true;
+        c.where = "intermediate";
+        if(!c.ensure(c.ix.data())) return !c.error && !c.halted();
+        if(c.bad_value) return true;
+        double viol = 0.0;
+        for(uz i = 0; i < c.mi; ++i) viol = std::max(viol, c.g[i]);
+        for(uz i = 0; i < c.me; ++i) viol = std::max(viol, std::fabs(c.h[i]));
+        bool inside = true;
+        for(uz j = 0; j < c.n; ++j)
+            inside &= c.ix[j] >= c.opt.lb[j] && c.ix[j] <= c.opt.ub[j];
+        if(inside && c.f <= c.opt.stopval && viol <= c.opt.constraint_tol) {
+            c.stop_x = c.ix;
+            c.reason = StopReason::Stopval;
+            return false;
+        }
+    }
+    return true;
+}
+
+void str_option(IpoptProblem ip, const char * key, const char * value) {
+    AddIpoptStrOption(ip, const_cast<char *>(key), const_cast<char *>(value));
+}
+void num_option(IpoptProblem ip, const char * key, double value) {
+    AddIpoptNumOption(ip, const_cast<char *>(key), value);
+}
+void int_option(IpoptProblem ip, const char * key, int value) {
+    AddIpoptIntOption(ip, const_cast<char *>(key), value);
+}
+
+// GS_IPOPT_OPTS="key=value;key=value": integer, then number, then string.
+void env_options(IpoptProblem ip) {
+    const char * env = std::getenv("GS_IPOPT_OPTS");
+    if(!env) return;
+    std::string all(env);
+    std::size_t pos = 0;
+    while(pos < all.size()) {
+        std::size_t end = all.find(';', pos);
+        if(end == std::string::npos) end = all.size();
+        const std::string item = all.substr(pos, end - pos);
+        pos = end + 1;
+        const std::size_t eq = item.find('=');
+        if(eq == std::string::npos) continue;
+        std::string key = item.substr(0, eq), value = item.substr(eq + 1);
+        char * kp = key.data();
+        char * stop = nullptr;
+        const long iv = std::strtol(value.c_str(), &stop, 10);
+        if(!value.empty() && *stop == '\0' &&
+           AddIpoptIntOption(ip, kp, static_cast<ipindex>(iv)))
+            continue;
+        const double dv = std::strtod(value.c_str(), &stop);
+        if(!value.empty() && *stop == '\0' && AddIpoptNumOption(ip, kp, dv))
+            continue;
+        AddIpoptStrOption(ip, kp, value.data());
+    }
+}
+
+std::atomic<long> g_output_counter{0};
+
+LocalStatus status_of(int s, StopReason reason) {
+    switch(s) {
+        case Solve_Succeeded:
+        case Solved_To_Acceptable_Level:
+        case Feasible_Point_Found:
+            return LocalStatus::Converged;
+        case User_Requested_Stop:
+            switch(reason) {
+                case StopReason::Stopval: return LocalStatus::StopvalReached;
+                case StopReason::Maxeval: return LocalStatus::MaxevalReached;
+                case StopReason::Stop: return LocalStatus::Stopped;
+                default: return LocalStatus::Failure;
+            }
+        case Maximum_Iterations_Exceeded:
+            return LocalStatus::MaxevalReached;
+        case Maximum_CpuTime_Exceeded:
+        case Maximum_WallTime_Exceeded:
+            return LocalStatus::MaxtimeReached;
+        case Invalid_Option:
+        case Invalid_Problem_Definition:
+        case Not_Enough_Degrees_Of_Freedom:
+            return LocalStatus::InvalidArgs;
+        default:
+            return LocalStatus::Failure;
+    }
+}
+
+}  // namespace
+
+void ipopt_minimize(LocalProblem & problem, std::vector<double> & x,
+                    const LocalOptions & o, LocalResult & r,
+                    std::exception_ptr & error) {
+    Ctx c(problem, o);
+    const uz n = c.n, m = c.m;
+    std::vector<double> xl(n), xu(n), gl(m, -kIpoptInf), gu(m, 0.0);
+    for(uz j = 0; j < n; ++j) {
+        xl[j] = std::isfinite(o.lb[j]) ? o.lb[j] : -kIpoptInf;
+        xu[j] = std::isfinite(o.ub[j]) ? o.ub[j] : kIpoptInf;
+    }
+    for(uz i = c.mi; i < m; ++i) gl[i] = 0.0;
+    const ipindex nele_jac = static_cast<ipindex>(m * n);
+    const ipindex nele_hess = static_cast<ipindex>(n * (n + 1) / 2);
+    IpoptProblem ip = CreateIpoptProblem(
+        static_cast<ipindex>(n), xl.data(), xu.data(), static_cast<ipindex>(m),
+        gl.data(), gu.data(), nele_jac, nele_hess, 0, &eval_f, &eval_g,
+        &eval_grad_f, &eval_jac_g, &eval_h);
+    if(!ip) {
+        r.status = LocalStatus::InvalidArgs;
+        r.message = "CreateIpoptProblem failed";
+        return;
+    }
+    c.ip = ip;
+    str_option(ip, "sb", "yes");
+    int_option(ip, "print_level", 0);
+    num_option(ip, "tol", 1e-8);
+    num_option(ip, "constr_viol_tol", o.constraint_tol);
+    num_option(ip, "acceptable_constr_viol_tol", o.constraint_tol);
+    int_option(ip, "max_iter", 1000000);
+    str_option(ip, "linear_solver", "mumps");
+    num_option(ip, "bound_relax_factor", 0.0);
+    str_option(ip, "honor_original_bounds", "yes");
+    str_option(ip, "hessian_approximation", c.fd ? "exact" : "limited-memory");
+    if(o.maxtime > 0.0) num_option(ip, "max_wall_time", o.maxtime);
+    if(const char * out = std::getenv("GS_IPOPT_OUTPUT")) {
+        const char * lvl = std::getenv("GS_IPOPT_PRINT");
+        std::string file = std::string(out) + "." +
+                           std::to_string(g_output_counter.fetch_add(1));
+        OpenIpoptOutputFile(ip, file.data(), lvl ? std::atoi(lvl) : 5);
+    }
+    env_options(ip);
+    SetIntermediateCallback(ip, &intermediate);
+
+    std::vector<double> xs = x;
+    double obj = 0.0;
+    const int status =
+        IpoptSolve(ip, xs.data(), nullptr, &obj, nullptr, nullptr, nullptr, &c);
+    FreeIpoptProblem(ip);
+    error = c.error;
+
+    if(c.reason == StopReason::Stopval && c.stop_x.size() == n)
+        xs = c.stop_x;
+    bool finite = true;
+    for(const double v : xs) finite &= std::isfinite(v);
+    if(finite)
+        for(uz j = 0; j < n; ++j) x[j] = std::clamp(xs[j], o.lb[j], o.ub[j]);
+    r.nlopt_code = status;
+    r.status = status_of(status, c.reason);
+    if(r.status == LocalStatus::Stopped && c.reason != StopReason::Stop)
+        r.status = LocalStatus::Failure;
+    // The stop flag can end the solve before the first intermediate call
+    // (the callbacks then fail), with any return status.
+    if(c.reason == StopReason::Stop) r.status = LocalStatus::Stopped;
+    r.message = std::string(ipopt_status_name(status));
+    if(status == User_Requested_Stop)
+        r.message += c.reason == StopReason::Stopval   ? " (stopval)"
+                     : c.reason == StopReason::Maxeval ? " (maxeval)"
+                     : c.reason == StopReason::Stop    ? " (stop flag)"
+                                                       : " (error)";
+    r.evaluations = c.evaluations;
+    r.gradient_evaluations = c.gradient_evaluations;
+    r.nonfinite = c.nonfinite;
+    r.hessian_evaluations = c.hessian_evaluations;
+    r.hessians = c.hessians;
+    r.out_of_bounds = c.out_of_bounds;
+    r.out_of_bounds_max = c.oob_max;
+    r.iterations = c.iterations;
+}
+
+}  // namespace gs::detail
