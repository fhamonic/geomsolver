+// Steelman experiment: identity of each Phase2 solver row ([ineq; eq] order
+// of NlpProblem), so Ipopt multipliers survive sample insertion.
+using RowKey = std::tuple<int, int, int, double>;
+std::vector<RowKey> p2_keys(const Model & m, const NlpProblem & P) {
+    const NlpLayout & L = P.layout();
+    const SampleSets & S = P.samples();
+    auto tval = [&](int sweep, int sample) {
+        return (sweep >= 0 && sample >= 0) ? S.t[uz(sweep)][uz(sample)] : -1e300;
+    };
+    std::vector<RowKey> ineq, eq;
+    for(const NlpRow & r : L.rows) {
+        const RowGroup & g = m.groups()[uz(r.group)];
+        (g.equality ? eq : ineq)
+            .emplace_back(0, r.group, r.split, tval(g.sweep, r.sample));
+    }
+    for(const NlpObjPiece & pc : L.objective)
+        if(pc.epigraph)
+            ineq.emplace_back(1, pc.criterion, 0,
+                              tval(m.criteria()[uz(pc.criterion)].sweep, pc.sample));
+    ineq.insert(ineq.end(), eq.begin(), eq.end());
+    return ineq;
+}
