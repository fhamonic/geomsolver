{
  "format": "geomsolver-instance/1",
  "description": "Two goals with a concave trade-off: a point P of the unit square must stay outside the unit disk centred on the origin, and both of its coordinates should be small. The Pareto front is the quarter circle.",
  "params": {
    "y_max": 0.6,
    "w": 0.5
  },
  "geometry": {
    "disk": {"type": "circle", "x": 0, "y": 0, "r": 1}
  },
  "design": {
    "P": {"type": "point", "domain": "box(0, 0, 1, 1)", "value": [0.9, 0.5]}
  },
  "constraints": [
    {"name": "outside", "expr": "clearance(P, disk) >= 0"}
  ],
  "criteria": [
    {"name": "x", "expr": "P.x", "role": "minimize"},
    {"name": "y", "expr": "P.y", "role": "max", "bound": "y_max"},
    {"name": "weighted", "expr": "P.x + w * P.y", "role": "report"}
  ],
  "display": [
    {"expr": "P", "color": "#eb5757", "label": "P"}
  ]
}
